devices:
# Example of a device with LLDP/CDP topology discovery enabled:
#
#   core_switch_1:
#     device_name: core-sw-1
#     device_ip: 10.10.0.2
#     snmp_comm: public
#     # Walk LLDP-MIB and/or CISCO-CDP-MIB during every metadata poll and
#     # emit one KSnmpTopology JCHF record per discovered neighbor.
#     discover_neighbors: true
#     # Restrict to a single protocol if desired; omit to walk both.
#     # neighbor_protocols: [lldp]
trap:
  listen: 127.0.0.1:162
  community: hello
  version: ""
  transport: ""
discovery:
  cidrs:
  - 10.10.0.0/24
  debug: false
  ports:
  - 161
  default_communities:
  - public
  default_v3: null
  add_devices: true
  add_mibs: true
  threads: 4
  replace_devices: true
  use_snmp_v1: false
global:
  poll_time_sec: 60
  drop_if_outside_poll: false
  mib_profile_dir: profiles
  pymib_profile_dir: ""
  mibs_db: ""
  mibs_enabled:
  - IF-MIB
  timeout_ms: 3000
  retries: 0
