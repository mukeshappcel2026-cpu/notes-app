 pkg/inputs/snmp/metadata/topology_test.go | 112 +++++++++++++++
 2 files changed, 270 insertions(+), 8 deletions(-)
 create mode 100644 vendor/ktranslate/pkg/inputs/snmp/metadata/topology_test.go

